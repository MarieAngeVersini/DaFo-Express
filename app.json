{
  "expo": {
    "name": "DaFoExpress",
    "slug": "DaFoExpress",
    "version": "1.0.0",
    "scheme": "dafoexpress",
    "ios": {
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/images/dafo-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dafo-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
